rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 Google 계정 — 결과를 볼 사람의 이메일로 바꾸세요 (여러 명 가능)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['p.hyunsoo@gmail.com'];
    }

    match /responses/{id} {
      // 누구나 응답 '제출'만 가능 (수정·삭제·조회 불가)
      allow create: if request.resource.data.keys().hasOnly(['rid', 'version', 'route', 'answers', 'durationSec', 'xp', 'submittedAt'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 45
        && request.resource.data.rid is string && request.resource.data.rid.size() <= 64
        && request.resource.data.durationSec is int
        && request.resource.data.submittedAt == request.time
        && (!('F5' in request.resource.data.answers) || request.resource.data.answers.F5.size() <= 1000)
        && (!('F6' in request.resource.data.answers) || request.resource.data.answers.F6.size() <= 1000);

      // 결과 조회는 관리자만
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
